<Project Sdk="Microsoft.NET.Sdk">
  <!-- Props/targets are automatically imported by NuGet, but here we need to do it manually. -->
  <!-- This needs to be done before any other props or targets, to match NuGet's behavior. -->
  <Import Project="../Binternal/Binternal.Local.props" />
  <Import Project="../Binternal/Binternal.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpier.MSBuild" PrivateAssets="all" />

    <!-- Package A: internalized -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Internalize="true" />

    <!-- Package B: direct, not internalized (also transitive through package A) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
