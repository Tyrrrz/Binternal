<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <BinternalTaskAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'"
      >$(MSBuildThisFileDirectory)/../tasks/netstandard2.0/Binternal.dll</BinternalTaskAssembly
    >
    <BinternalTaskAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'"
      >$(MSBuildThisFileDirectory)/../tasks/net472/Binternal.dll</BinternalTaskAssembly
    >
  </PropertyGroup>

  <UsingTask TaskName="Binternal.InternalizationTask" AssemblyFile="$(BinternalTaskAssembly)" />
</Project>
