<Project
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
  ToolsVersion="4.0"
>
  <!-- Mark internalized package references as private so they are excluded from the generated nuspec -->
  <Target
    Name="_BinternalSetPrivateAssets"
    BeforeTargets="GenerateNuspec"
    Condition="@(PackageReference->WithMetadataValue('Internalize', 'true')->Count()) > 0"
  >
    <ItemGroup>
      <PackageReference
        Condition="'%(PackageReference.Internalize)' == 'true'"
        Update="%(PackageReference.Identity)"
      >
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>
  </Target>

  <!-- Run after the build to internalize marked package references -->
  <Target
    Name="_BinternalMerge"
    AfterTargets="Build"
    Condition="@(PackageReference->WithMetadataValue('Internalize', 'true')->Count()) > 0"
  >
    <BinternalTask
      TargetAssembly="$(TargetPath)"
      PackageReferences="@(PackageReference)"
      ReferenceCopyLocalPaths="@(ReferenceCopyLocalPaths)"
    />
  </Target>
</Project>
