<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <!-- Mark internalized package references as private so they are excluded from package dependencies -->
  <Target Name="Binternal_SetPrivateAssets" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <PackageReference
        Condition="'%(PackageReference.Internalize)' != '' and %(PackageReference.Internalize)"
        Update="%(PackageReference.Identity)"
      >
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>
  </Target>

  <!-- Merge package references and project references into the target assembly -->
  <Target Name="Binternal_Merge" AfterTargets="Build">
    <BinternalTask
      PackageReferences="@(PackageReference)"
      ProjectReferences="@(ProjectReference)"
      ReferenceCopyLocalPaths="@(ReferenceCopyLocalPaths);@(RuntimeCopyLocalItems)"
      TargetFilePath="$(TargetPath)"
    />
  </Target>
</Project>
