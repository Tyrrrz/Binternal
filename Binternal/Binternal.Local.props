<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <Import Project="Binternal.props" />

  <!-- Props for local testing, used by the demo project -->
  <PropertyGroup>
    <BinternalTaskAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'"
      >$(MSBuildThisFileDirectory)/bin/$(Configuration)/netstandard2.0/Binternal.dll</BinternalTaskAssembly
    >
    <BinternalTaskAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'"
      >$(MSBuildThisFileDirectory)/bin/$(Configuration)/net472/Binternal.dll</BinternalTaskAssembly
    >
  </PropertyGroup>
</Project>
