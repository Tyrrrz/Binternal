<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <!-- Import the local Binline props for development/testing -->
  <Import Project="../Binline/Binline.Local.props" />
  <Import Project="../Binline/Binline.targets" />

  <ItemGroup>
    <!-- Example: inline Newtonsoft.Json as an internal dependency -->
    <PackageReference Include="Newtonsoft.Json">
      <Binline>true</Binline>
    </PackageReference>
  </ItemGroup>
</Project>
